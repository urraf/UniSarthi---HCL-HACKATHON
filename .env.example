# Copy this file to backend/.env and fill in the values.
# Nothing secret is written in the code: everything is read from here.

# ---------- LLM ----------
# groq   -> cloud model on Groq (needs GROQ_API_KEY)
# ollama -> local model via Ollama (the guide's default choice)
# mock   -> no LLM: keyword rules + templates (used by tests)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Tried in order when a model hits its daily token limit
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ---------- Retrieval ----------
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=4
# Minimum similarity (0-1) for a chunk to count as evidence (tuned on the eval set, see eval/retrieval_comparison.md)
MIN_SIMILARITY=0.50

# ---------- Authentication ----------
# Long random string used to sign login tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# How long a login token stays valid
TOKEN_HOURS=8
# true  -> /ask needs a valid login token for personal questions
# false -> the X-Student-Id header alone is accepted (the guide's contract,
#          used by the judges' test scripts). A token, if sent, is still checked.
AUTH_REQUIRED=false
# Demo only: password for demo accounts made by scripts/create_logins.py (real students sign up with OTP)
DEFAULT_STUDENT_PASSWORD=
# true -> at startup every student without an account gets a demo account (no email) with DEFAULT_STUDENT_PASSWORD
CREATE_DEMO_ACCOUNTS=false
# true -> POST /ingest needs a staff login token (production). false keeps the guide's open /ingest for judges.
INGEST_REQUIRES_ADMIN=false

# ---------- MongoDB (accounts, OTPs, chat history) ----------
MONGODB_URI=
MONGODB_DB=unisarthi
# First university staff account (can add documents). Created at startup if both are set.
BOOTSTRAP_ADMIN_ID=
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- Email for OTPs (SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALLOWED_EMAIL_DOMAIN=nsut.ac.in
OTP_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Development only: print OTPs in the server log when SMTP is not configured
DEV_PRINT_OTP=false

# ---------- Frontend ----------
# Which origins may call the API from a browser (comma separated)
CORS_ORIGINS=http://localhost:5173
